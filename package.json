{
  "name": "magpie-quwork",
  "version": "0.19.3",
  "description": "QuWork（qurvis）provider plugin for magpie：手机号/浏览器登录、模型代理、积分卡片、邀请码与权益面板、微信扫码绑定门户（固定码群发绑号）",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "server.mjs",
    "src",
    "page",
    "scripts",
    "README.md"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "quwork",
    "qurvis",
    "provider",
    "auth"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test",
    "panel": "node server.mjs",
    "bind-qr": "node scripts/bind-qr.mjs",
    "bind-server": "node scripts/bind-server.mjs",
    "bind-tunnel": "node scripts/bind-tunnel.mjs",
    "bind-log": "node scripts/bind-log.mjs",
    "bind-once": "node scripts/bind-once.mjs",
    "bind-up": "pwsh -File scripts/bind-up.ps1",
    "bind-batch": "node scripts/bind-batch.mjs",
    "bind-wall-static": "node scripts/bind-wall-static.mjs"
  },
  "magpie": {
    "name": "QuWork",
    "maxConcurrency": 4,
    "summary": {
      "en": "QuWork (qurvis): multi-account console (credits, invite codes, check-in, WeChat binding), a standalone public fixed-QR WeChat bind portal, OpenAI-compatible model proxy, two sign-in paths.",
      "zh": "QuWork（qurvis）：多账号表格面板（积分 / 邀请码 / 签到 / 微信绑定）、可独立上公网的固定二维码微信扫码绑定门户、OpenAI 兼容模型代理、两种登录方式。"
    },
    "page": {
      "title": "QuWork 面板",
      "titles": {
        "zh": "QuWork 面板",
        "zh-TW": "QuWork 面板"
      },
      "file": "page/gateway.html",
      "service": {
        "port": 4392,
        "option": "port"
      }
    },
    "options": {
      "baseUrl": "https://llm.quwork.cn/v1",
      "platformBaseUrl": "https://llm.rrzu.com",
      "port": 4392
    }
  }
}
